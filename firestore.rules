rules_version = '2';

// Firestore Security Rules — Portal Latihan TKA 2026 (multi-sekolah)
// Satu project Firebase; isolasi data lewat field sekolahId.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function staffData() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isStaff() && staffData().peran == 'admin';
    }

    function isGuru() {
      return isStaff() && staffData().peran == 'guru';
    }

    // sekolahId user (staff). Admin super: tidak terikat satu sekolah.
    function staffSekolahId() {
      return staffData().sekolahId;
    }

    // ─── Master sekolah (gerbang publik hanya baca yang aktif) ───
    match /sekolah/{sekolahId} {
      allow read: if resource.data.aktif == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Roster dropdown login — HANYA nama, kelas, emailLogin, jenis, sekolahId
    // (tanpa NISN / password). Dibaca sebelum login.
    match /loginRoster/{rosterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /staff/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow write: if isAdmin();
    }

    match /students/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Bank soal — fase transisi: staff masih full access.
    // Fase berikutnya: filter sekolahId di rules + query.
    match /questionPool/{questionId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /soalPublik/{questionId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /bacaanPool/{bacaanId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /ilustrasiSoal/{ilustrasiId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /packages/{packageId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // Notifikasi in-app (admin: pengajuan baru; guru: status usulan)
    match /notifikasi/{id} {
      allow read: if isStaff() && (
        resource.data.targetUid == request.auth.uid
        || (resource.data.targetRole == 'admin' && isAdmin())
      );
      allow create: if isStaff();
      allow update: if isStaff() && (
        resource.data.targetUid == request.auth.uid
        || (resource.data.targetRole == 'admin' && isAdmin())
      );
      allow delete: if isAdmin()
        || (isStaff() && resource.data.targetUid == request.auth.uid);
    }

    // Pengajuan try out oleh guru → ditinjau admin (fase 3+)
    match /pengajuanPaket/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.diajukanOleh == request.auth.uid
        && request.resource.data.status == 'diajukan';
      allow update: if isAdmin()
        || (isStaff()
            && resource.data.diajukanOleh == request.auth.uid
            && resource.data.status == 'diajukan'
            && request.resource.data.status == 'diajukan');
      allow delete: if isAdmin();
    }

    match /liveSessions/{sessionId} {
      allow read: if isStaff();
      allow create, update: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid
        && sessionId == request.resource.data.packageId + '_' + request.auth.uid;
      allow delete: if isStaff()
        || (isSignedIn() && resource.data.studentId == request.auth.uid);
    }

    match /attempts/{attemptId} {
      allow create: if isSignedIn() &&
        request.resource.data.studentId == request.auth.uid;
      allow read: if isStaff() ||
        (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow update: if isStaff();
      allow delete: if isStaff();
    }
  }
}

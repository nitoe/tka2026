rules_version = '2';

// Firestore Security Rules — Portal Latihan TKA 2026
// SD Muhammadiyah 01 Kukusan

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function staffData() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isStaff() && staffData().peran == 'admin';
    }

    match /staff/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow write: if isAdmin();
    }

    match /students/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questionPool/{questionId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /soalPublik/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /bacaanPool/{bacaanId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /ilustrasiSoal/{ilustrasiId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // HASIL PENGERJAAN
    // Siswa create attempt sendiri; tidak bisa update/delete sendiri.
    // Staff boleh DELETE (reset try out di guru/rekap-tryout.html).
    // Update tetap ditolak — skor tidak boleh diedit manual.
    match /attempts/{attemptId} {
      allow create: if isSignedIn() &&
        request.resource.data.studentId == request.auth.uid;
      allow read: if isStaff() ||
        (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow update: if false;
      allow delete: if isStaff();
    }
  }
}
